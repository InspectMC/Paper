Subject: [PATCH] Add SystemLink advanced knockback configuration


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 3a4da514c163e7565fc241835db52c464a5c4734..784af721cf4dff2175a5182526c1f57fe2fde7c1 100644
