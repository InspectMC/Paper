+        // Paper start - Add SystemLink advanced knockback configuration
+        final dev.systemlink.spigot.knockback.AdvancedKnockbackConfiguration knockbackProfile = this.level().paperConfig().systemLink.advancedKnockback;
+        final double baseKnockback = knockbackProfile.enabled ? knockbackProfile.baseKnockback : 0.4F;
+        this.knockback(baseKnockback, xd, zd, source, damage, source.getDirectEntity(), source.getDirectEntity() == null ? io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.DAMAGE : io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.ENTITY_ATTACK); // CraftBukkit // Paper - knockback events
+        // Paper end - Add SystemLink advanced knockback configuration
         if (!blocked) {
             this.indicateDamage(xd, zd);
         }
@@ -1734,7 +1738,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     protected void blockedByItem(final LivingEntity defender, final DamageSource source, final float damage) {
-        defender.knockback(0.5, defender.getX() - this.getX(), defender.getZ() - this.getZ(), source, damage, this, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.SHIELD_BLOCK); // CraftBukkit // Paper - fix attacker & knockback events
+        // Paper start - Add SystemLink advanced knockback configuration
+        final dev.systemlink.spigot.knockback.AdvancedKnockbackConfiguration knockbackProfile = this.level().paperConfig().systemLink.advancedKnockback;
+        final double shieldKnockback = knockbackProfile.enabled ? knockbackProfile.shieldHitKnockback : 0.5;
+        defender.knockback(shieldKnockback, defender.getX() - this.getX(), defender.getZ() - this.getZ(), source, damage, this, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.SHIELD_BLOCK); // CraftBukkit // Paper - fix attacker & knockback events
+        // Paper end - Add SystemLink advanced knockback configuration
     }
 
     private boolean checkTotemDeathProtection(final DamageSource killingDamage) {
@@ -2057,7 +2065,20 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     public void knockback(double power, double xd, double zd, final DamageSource source, final float damage, final boolean comesFromEffect, @Nullable Entity attacker, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eventCause) { // Paper - knockback events
-        power *= 1.0 - this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE);
+        this.knockback(power, xd, zd, source, damage, comesFromEffect, attacker, eventCause, null); // Paper - Add SystemLink KnockbackBuilder API
+    }
+
+    // Paper start - Add SystemLink KnockbackBuilder API
+    private void knockback(double power, double xd, double zd, final DamageSource source, final float damage, final boolean comesFromEffect, @Nullable Entity attacker, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eventCause, dev.systemlink.spigot.knockback.@Nullable Knockback customKnockback) {
+    // Paper end - Add SystemLink KnockbackBuilder API
+        // Paper start - Add SystemLink advanced knockback configuration
+        final dev.systemlink.spigot.knockback.AdvancedKnockbackConfiguration knockbackProfile = this.level().paperConfig().systemLink.advancedKnockback;
+        power = customKnockback != null
+            ? customKnockback.applyResistance(this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE))
+            : knockbackProfile.enabled
+            ? knockbackProfile.applyResistance(power, this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE))
+            : power * (1.0 - this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE));
+        // Paper end - Add SystemLink advanced knockback configuration
         if (true || !(power <= 0.0)) { // CraftBukkit - Call event even when force is 0
             // this.needsSync = true; // Paper - moved down
             Vec3 deltaMovement = this.getDeltaMovement();
@@ -2070,7 +2091,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             Vec3 deltaVector = new Vec3(xd, 0.0, zd).normalize().scale(power);
             Vec3 targetMovement = new Vec3( // Paper - knockback events
                 deltaMovement.x / 2.0 - deltaVector.x,
-                this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + power) : deltaMovement.y,
+                customKnockback != null
+                    ? customKnockback.verticalVelocity(deltaMovement.y, power, this.onGround())
+                    : knockbackProfile.enabled
+                    ? knockbackProfile.verticalVelocity(deltaMovement.y, power, this.onGround())
+                    : this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + power) : deltaMovement.y, // Paper - Add SystemLink advanced knockback configuration
                 deltaMovement.z / 2.0 - deltaVector.z
             );
             // Paper start - knockback events
@@ -2086,6 +2111,12 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         }
     }
 
+    // Paper start - Add SystemLink KnockbackBuilder API
+    public void knockback(final dev.systemlink.spigot.knockback.Knockback knockback, final DamageSource source, final float damage) {
+        this.knockback(knockback.strength(), knockback.directionX(), knockback.directionZ(), source, damage, false, null, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.UNKNOWN, knockback);
+    }
+    // Paper end - Add SystemLink KnockbackBuilder API
+
     public void knockback(final double power, final double xd, final double zd, final DamageSource source, final float damage) {
         // Paper start - knockback events
         this.knockback(power, xd, zd, source, damage, null, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.UNKNOWN);
