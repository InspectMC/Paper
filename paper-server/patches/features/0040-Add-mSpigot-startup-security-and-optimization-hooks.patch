+    ) {
+        return snapshot != null
+            && snapshot.gameplay().spawnerSettings().enabled()
+            && !snapshot.gameplay().spawnerSettings().checks().spawnerBlockChecks()
+            || level.noCollision(entityType.getSpawnAABB(spawnPos.x, spawnPos.y, spawnPos.z));
+    }
