+        final ServerLevel level,
+        final BlockPos pos,
+        final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot snapshot
+    ) {
+        if (snapshot == null || !snapshot.gameplay().spawnerSettings().enabled()) {
+            return this.isNearPlayer(level, pos);
+        }
+        return !snapshot.gameplay().spawnerSettings().checks().checkForNearbyPlayers() || this.isNearPlayer(level, pos);
+    }
