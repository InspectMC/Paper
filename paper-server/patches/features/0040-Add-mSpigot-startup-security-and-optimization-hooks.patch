+    private void mSpigotApplySpawnerSettings(final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot snapshot) {
+        if (snapshot == null) {
+            return;
+        }
+        final dev.systemlink.spigot.configuration.MSpigotConfig.SpawnerRangeSettings spawners = snapshot.worldRuntime().spawners();
+        final int minRange = Math.min(spawners.minRange(), spawners.maxRange());
+        final int maxRange = Math.max(spawners.minRange(), spawners.maxRange());
+        this.spawnRange = Math.max(minRange, Math.min(maxRange, spawners.spawnRange()));
+        if (spawners.requiredPlayerRange() > 0) {
+            this.requiredPlayerRange = spawners.requiredPlayerRange();
+        }
+        if (spawners.spawnCount() > 0) {
+            this.spawnCount = spawners.spawnCount();
+        }
+        if (spawners.maxNearbyEntities() > 0) {
+            this.maxNearbyEntities = spawners.maxNearbyEntities();
+        }
+        final dev.systemlink.spigot.configuration.MSpigotConfig.SpawnerSettings settings = snapshot.gameplay().spawnerSettings();
+        if (settings.enabled()) {
+            this.minSpawnDelay = settings.minSpawnDelay();
+            this.maxSpawnDelay = Math.max(settings.minSpawnDelay(), settings.maxSpawnDelay());
+        }
+    }
