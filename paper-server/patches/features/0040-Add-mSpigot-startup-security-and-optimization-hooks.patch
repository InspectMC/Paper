+    private int mSpigotAdjustedChunkTickSpeed(final int tickSpeed) {
+        final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot snapshot = dev.systemlink.spigot.configuration.MSpigotConfig.current();
+        if (snapshot == null || tickSpeed <= 0) {
+            return tickSpeed;
+        }
+        return switch (snapshot.ticking().chunkMode()) {
+            case VANILLA -> tickSpeed;
+            case OPTIMIZED -> Math.max(1, tickSpeed / 2);
+            case EXTRA_OPTIMIZED -> Math.max(1, tickSpeed / 4);
+        };
+    }
