+        }
+        final ServerClockManager.ClockInstance instance = this.clocks.get(defaultClock.get());
+        if (instance == null) {
+            return false;
+        }
+        final long dayTime = Math.floorMod(instance.totalTicks, 24000L);
+        if (dayTime == 6000L) {
+            return false;
+        }
+        instance.totalTicks = instance.totalTicks - dayTime + 6000L;
+        instance.partialTick = 0.0F;
+        serverLevel.environmentAttributes().invalidateTickCache();
+        return true;
+    }
