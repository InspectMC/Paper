     }
 
+    private boolean systemLinkPacketFlood(final Packet<?> packet) {
+        final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot snapshot = dev.systemlink.spigot.configuration.MSpigotConfig.current();
+        if (snapshot == null || !snapshot.security().packetFlood().enabled()) {
+            return false;
+        }
+        final dev.systemlink.spigot.configuration.MSpigotConfig.PacketFloodSettings flood = snapshot.security().packetFlood();
+        final int limit = flood.maxPacketsPerSecond() + flood.burst();
+        if (limit <= 0) {
+            return false;
+        }
+        final long now = System.nanoTime();
+        if (this.systemLinkPacketFloodWindowStart == 0L || now - this.systemLinkPacketFloodWindowStart >= 1_000_000_000L) {
+            this.systemLinkPacketFloodWindowStart = now;
+            this.systemLinkPacketFloodWindowCount = 0;
+            this.systemLinkPacketFloodLogged = false;
+        }
+        if (++this.systemLinkPacketFloodWindowCount <= limit) {
+            return false;
+        }
+        if (!this.systemLinkPacketFloodLogged) {
+            LOGGER.warn(
+                "mSpigot blocked packet flood from {}: {} packets this second (limit {}, last packet {})",
+                this.getLoggableAddress(net.minecraft.server.MinecraftServer.getServer().logIPs()),
+                this.systemLinkPacketFloodWindowCount,
+                limit,
+                packet.getClass().getSimpleName()
+            );
+            this.systemLinkPacketFloodLogged = true;
+        }
+        if (flood.kickOnViolation()) {
+            this.stopReadingPackets = true;
+            this.disconnect(Component.literal("Too many packets"));
+        }
+        return true;
+    }
+
     private static <T extends PacketListener> void genericsFtw(final Packet<T> packet, final PacketListener listener) {
         packet.handle((T)listener);
     }
