     }
 
     private boolean useAsyncIO() {
-        final io.papermc.paper.configuration.GlobalConfiguration configuration = io.papermc.paper.configuration.GlobalConfiguration.get();
-        return configuration != null && configuration.systemLink != null && configuration.systemLink.asyncPlayerData.enabled;
+        return dev.systemlink.spigot.configuration.MSpigotConfig.asyncPlayerDataEnabled();
     }
     // Paper end - SystemLink async player data
 
