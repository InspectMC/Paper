     // Paper - don't store the vanilla dispatcher
     public boolean forceTicks;
     // CraftBukkit end
@@ -1636,17 +1637,28 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
         Profiler.get().push("save");
         final boolean fullSave = this.autosavePeriod > 0 && this.tickCount % this.autosavePeriod == 0;
+        final boolean stagedAutosave = dev.systemlink.spigot.configuration.MSpigotConfig.stagedAutosaveEnabled(); // Paper - Add mSpigot staged autosave
         try {
             this.isSaving = true;
             if (playerSaveInterval > 0) {
                 this.playerList.saveAll(playerSaveInterval);
             }
-            if (fullSave) {
-                this.saveGlobalData(false);
+            // Paper start - Add mSpigot staged autosave
+            if (stagedAutosave) {
+                if (fullSave) {
+                    this.mspigotAutoSave.start(this.getAllLevels());
+                }
+                this.mspigotAutoSave.execute();
+            } else {
+                this.mspigotAutoSave.reset();
+                if (fullSave) {
+                    this.saveGlobalData(false);
+                }
             }
+            // Paper end - Add mSpigot staged autosave
             for (final ServerLevel level : this.getAllLevels()) {
                 if (level.paperConfig().chunks.autoSaveInterval.value() > 0) {
-                    level.saveIncrementally(fullSave);
+                    level.saveIncrementally(fullSave && !stagedAutosave); // Paper - Add mSpigot staged autosave
                 }
             }
         } finally {
