             if (bb.contains(player.getX(), player.getY(), player.getZ()) && targetConditions.test(this.getLevel(), source, player)) {
                 foundPlayers.add(player);
             }
@@ -117,6 +120,29 @@ public interface ServerEntityGetter extends EntityGetter {
         return foundPlayers;
     }
 
+    // Paper start - Add mSpigot PlayerMap
+    private @Nullable Player mspigot$getNearestPlayer(
+        final TargetingConditions targetConditions,
+        final LivingEntity source,
+        final double x,
+        final double y,
+        final double z
+    ) {
+        double best = -1.0;
+        Player result = null;
+        for (final Player player : this.getLevel().playerMap.candidates(source.getX(), source.getZ(), targetConditions.range())) {
+            if (targetConditions.test(this.getLevel(), source, player)) {
+                final double distance = player.distanceToSqr(x, y, z);
+                if (best < 0.0 || distance < best) {
+                    best = distance;
+                    result = player;
+                }
+            }
+        }
+        return result;
+    }
+    // Paper end - Add mSpigot PlayerMap
