+    // Paper start - SystemLink async player data
+    public Optional<CompoundTag> load(final NameAndId nameAndId) {
+        if (this.useAsyncIO()) {
+            this.asyncIO.flush();
+        }
+        return this.loadFromDisk(nameAndId);
+    }
+
+    public java.util.concurrent.CompletableFuture<Optional<CompoundTag>> loadAsync(final NameAndId nameAndId) {
+        if (!this.useAsyncIO()) {
+            return java.util.concurrent.CompletableFuture.completedFuture(this.loadFromDisk(nameAndId));
+        }
+        return this.asyncIO.loadAsync(() -> this.loadFromDisk(nameAndId));
+    }
+
+    public void flush() {
+        this.asyncIO.flush();
+    }
+
+    private boolean useAsyncIO() {
+        final io.papermc.paper.configuration.GlobalConfiguration configuration = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return configuration != null && configuration.systemLink != null && configuration.systemLink.asyncPlayerData.enabled;
+    }
+    // Paper end - SystemLink async player data
