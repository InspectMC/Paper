+    public java.util.concurrent.CompletableFuture<Optional<CompoundTag>> loadPlayerDataAsync(final NameAndId nameAndId) {
+        final UUID lastSingleplayerOwnerUUID = this.server.getWorldData().getSinglePlayerUUID();
+        if (this.server.isSingleplayerOwner(nameAndId) && lastSingleplayerOwnerUUID != null) {
+            LOGGER.debug("loading single player asynchronously");
+            return this.playerIo.loadAsync(new NameAndId(lastSingleplayerOwnerUUID, "<singleplayer owner>"));
+        }
+        return this.playerIo.loadAsync(nameAndId);
+    }
+    // Paper end - SystemLink async player data
