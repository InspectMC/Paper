diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index a3a11047c66653e89444e6b435f4aca8553ecb5b..bfdcaf877240919a868f8064a7c9bfba24359ed3 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2936,7 +2936,13 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     public void setItemSlot(final EquipmentSlot slot, final ItemStack itemStack, final boolean silent) {
+        // Paper start - Add SystemLink equipment set event
+        final ItemStack oldStack = this.equipment.get(slot);
+        if (!ItemStack.isSameItemSameComponents(oldStack, itemStack) && !org.bukkit.craftbukkit.event.CraftEventFactory.callEquipmentSetEvent(this, slot, oldStack, itemStack)) {
+            return;
+        }
         this.onEquipItem(slot, this.equipment.set(slot, itemStack), itemStack, silent);
+        // Paper end - Add SystemLink equipment set event
         // Paper end
     }
 
diff --git a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
index 8d3c6abd387acc4cec27a33b96bcd24255fd01ac..1ef54320e7d47053f4d8be6851ba341ef7986cbe 100644
--- a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
