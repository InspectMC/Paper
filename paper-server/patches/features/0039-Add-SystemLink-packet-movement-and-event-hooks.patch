From: Inspect <42951016+InspectMC@users.noreply.github.com>
Date: Sun, 6 Sep 2026 14:29:28 -0500
Subject: [PATCH] Add SystemLink packet movement and event hooks


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 9fbc7e93712672dbab67f931e2aee447d803607b..5b49c6105c54822f7a097c1ee5b99b1ff4985f7d 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -268,6 +268,12 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
             }
             // Paper end - packet limiter
             if (packetListener.shouldHandleMessage(packet)) {
+                // Paper start - Add SystemLink packet handlers
+                final net.minecraft.server.level.ServerPlayer systemLinkPlayer = this.getPlayer();
+                if (systemLinkPlayer != null && !net.minecraft.server.MinecraftServer.getServer().server.mspigot().getPacketService().callPacket(systemLinkPlayer.getBukkitEntity(), packet, dev.systemlink.spigot.packet.PacketDirection.RECEIVED)) {
+                    return;
+                }
+                // Paper end - Add SystemLink packet handlers
                 try {
                     genericsFtw(packet, packetListener);
                 } catch (RunningOnDifferentThreadException var5) {
@@ -483,6 +489,13 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     // Paper end - Add netty task scheduling helper
 
     private void sendPacket(final Packet<?> packet, final @Nullable ChannelFutureListener listener, final boolean flush) {
+        // Paper start - Add SystemLink packet handlers
+        final net.minecraft.server.level.ServerPlayer systemLinkPlayer = this.getPlayer();
+        if (systemLinkPlayer != null && !net.minecraft.server.MinecraftServer.getServer().server.mspigot().getPacketService().callPacket(systemLinkPlayer.getBukkitEntity(), packet, dev.systemlink.spigot.packet.PacketDirection.SENT)) {
+            packet.onPacketDispatchFinish(systemLinkPlayer, null);
+            return;
+        }
+        // Paper end - Add SystemLink packet handlers
         this.sentPackets++;
         if (this.channel.eventLoop().inEventLoop()) {
             this.doSendPacket(packet, listener, flush);
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index c2aba28916da7f8b0bc8a325cddaa9bb7ecfb251..4b466061fb3862e325633d01f33a0b7fd811c2ea 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -873,7 +873,7 @@ public class ServerGamePacketListenerImpl
         }
 
         // Paper start - AsyncTabCompleteEvent
-        final com.destroystokyo.paper.event.server.AsyncTabCompleteEvent event = new com.destroystokyo.paper.event.server.AsyncTabCompleteEvent(this.getCraftPlayer(), packet.getCommand(), true, null);
+        final com.destroystokyo.paper.event.server.AsyncTabCompleteEvent event = new org.bukkit.event.server.AsyncTabCompleteEvent(this.getCraftPlayer(), packet.getCommand(), true, null);
         event.callEvent();
         final List<com.destroystokyo.paper.event.server.AsyncTabCompleteEvent.Completion> completions = event.isCancelled() ? com.google.common.collect.ImmutableList.of() : event.completions();
         // If the event isn't handled, we can assume that we have no completions, and so we'll ask the server
@@ -1483,6 +1483,28 @@ public class ServerGamePacketListenerImpl
                         double targetX = clampHorizontal(packet.getX(this.player.getX()));
                         double targetY = clampVertical(packet.getY(this.player.getY()));
                         double targetZ = clampHorizontal(packet.getZ(this.player.getZ()));
+                        // Paper start - Add SystemLink movement handlers
+                        final org.bukkit.entity.Player systemLinkPlayer = this.getCraftPlayer();
+                        final org.bukkit.Location systemLinkFrom = new org.bukkit.Location(systemLinkPlayer.getWorld(), this.player.getX(), this.player.getY(), this.player.getZ(), this.player.getYRot(), this.player.getXRot());
+                        final org.bukkit.Location systemLinkTo = new org.bukkit.Location(systemLinkPlayer.getWorld(), targetX, targetY, targetZ, targetYRot, targetXRot);
+                        final dev.systemlink.spigot.movement.MovementService systemLinkMovementService = this.server.server.mspigot().getMovementService();
+                        boolean systemLinkWasJustTeleported = this.justTeleported;
+                        if (packet.hasPosition() && !systemLinkMovementService.callMovement(systemLinkPlayer, dev.systemlink.spigot.movement.MovementType.LOCATION, systemLinkFrom, systemLinkTo, packet)) {
+                            this.internalTeleport(systemLinkFrom);
+                            return;
+                        }
+                        if (!systemLinkWasJustTeleported && this.justTeleported) {
+                            return;
+                        }
+                        systemLinkWasJustTeleported = this.justTeleported;
+                        if (packet.hasRotation() && !systemLinkMovementService.callMovement(systemLinkPlayer, dev.systemlink.spigot.movement.MovementType.ROTATION, systemLinkFrom, systemLinkTo, packet)) {
+                            this.internalTeleport(systemLinkFrom);
+                            return;
+                        }
+                        if (!systemLinkWasJustTeleported && this.justTeleported) {
+                            return;
+                        }
+                        // Paper end - Add SystemLink movement handlers
                         if (this.player.isPassenger()) {
                             this.player.absSnapTo(this.player.getX(), this.player.getY(), this.player.getZ(), targetYRot, targetXRot);
                             this.player.level().getChunkSource().move(this.player);
diff --git a/net/minecraft/world/effect/MobEffectInstance.java b/net/minecraft/world/effect/MobEffectInstance.java
