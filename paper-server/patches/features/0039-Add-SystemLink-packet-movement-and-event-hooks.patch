@@ -111,6 +111,12 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
                         ServerPlayer newOwner = player.teleport(new TeleportTransition(
                             level, teleportPos, Vec3.ZERO, 0.0F, 0.0F, Relative.union(Relative.ROTATION, Relative.DELTA), TeleportTransition.DO_NOTHING).withCause(org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.ENDER_PEARL));
                         if (newOwner == null) {
+                            // Paper start - Add SystemLink pearl refund event
+                            final org.bukkit.event.player.PlayerPearlRefundEvent event = new org.bukkit.event.player.PlayerPearlRefundEvent(player.getBukkitEntity(), (org.bukkit.entity.EnderPearl) this.getBukkitEntity());
+                            if (event.callEvent()) {
+                                player.getInventory().placeItemBackInInventory(new ItemStack(Items.ENDER_PEARL));
+                            }
+                            // Paper end - Add SystemLink pearl refund event
                             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT);
                             return;
                         }
diff --git a/net/minecraft/world/inventory/ArmorSlot.java b/net/minecraft/world/inventory/ArmorSlot.java
index d3495bcdb4985005ae903ee26853542db06584a6..446fb6381164f785c15511586111d19ce301ac3e 100644
--- a/net/minecraft/world/inventory/ArmorSlot.java
+++ b/net/minecraft/world/inventory/ArmorSlot.java
@@ -32,6 +32,11 @@ public class ArmorSlot extends Slot {
 
     @Override
     public void setByPlayer(final ItemStack itemStack, final ItemStack previous) {
+        // Paper start - Add SystemLink equipment set event
+        if (!ItemStack.isSameItemSameComponents(previous, itemStack) && !org.bukkit.craftbukkit.event.CraftEventFactory.callEquipmentSetEvent(this.owner, this.slot, previous, itemStack)) {
+            return;
+        }
+        // Paper end - Add SystemLink equipment set event
         this.owner.onEquipItem(this.slot, previous, itemStack);
         super.setByPlayer(itemStack, previous);
     }
