+    private boolean mSpigotSuppressLeftShooting() {
+        final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot systemLinkSnapshot = dev.systemlink.spigot.configuration.MSpigotConfig.current();
+        if (systemLinkSnapshot == null || !systemLinkSnapshot.gameplay().tnt().disableLeftShooting()) {
+            return false;
+        }
+        final ItemStack itemStack = this.player.getInventory().getSelectedItem();
+        return itemStack.is(Items.ENDER_PEARL)
+            || itemStack.is(Items.SPLASH_POTION)
+            || itemStack.is(Items.LINGERING_POTION)
+            || itemStack.is(Items.SNOWBALL)
+            || itemStack.is(Items.EGG)
+            || itemStack.is(Items.BOW)
+            || itemStack.is(Items.CROSSBOW)
+            || itemStack.is(Items.TRIDENT);
+    }
