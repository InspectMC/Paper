+    private Vec3 mSpigotTeleportPosition(final HitResult hitResult, final ServerLevel level) {
+        final dev.systemlink.spigot.configuration.MSpigotConfig.Snapshot systemLinkSnapshot = dev.systemlink.spigot.configuration.MSpigotConfig.current();
+        if (systemLinkSnapshot == null || !systemLinkSnapshot.gameplay().pearls().talibanPearls() || !(hitResult instanceof BlockHitResult blockHitResult) || blockHitResult.isWorldBorderHit()) {
+            return this.oldPosition();
+        }
+
+        final BlockPos pos = blockHitResult.getBlockPos();
+        final BlockState state = level.getBlockState(pos);
+        final dev.systemlink.spigot.configuration.MSpigotConfig.PearlSettings settings = systemLinkSnapshot.gameplay().pearls();
+        if (!mSpigotAllowsPearlThrough(state, level, pos, settings)) {
+            return this.oldPosition();
+        }
+
+        Vec3 direction = this.getDeltaMovement();
+        if (direction.lengthSqr() < 1.0E-7) {
+            direction = blockHitResult.getDirection().getUnitVec3().scale(-1.0);
+        } else {
+            direction = direction.normalize();
+        }
+        return blockHitResult.getLocation().add(direction.scale(settings.passThroughDistance()));
+    }
+
+    private static boolean mSpigotAllowsPearlThrough(
+        final BlockState state,
+        final ServerLevel level,
+        final BlockPos pos,
+        final dev.systemlink.spigot.configuration.MSpigotConfig.PearlSettings settings
+    ) {
+        return settings.partialBlocks() && !state.isCollisionShapeFullBlock(level, pos)
+            || settings.fences() && (state.is(BlockTags.FENCES) || state.is(BlockTags.FENCE_GATES) || state.is(BlockTags.WALLS))
+            || settings.stairsAndSlabs() && (state.is(BlockTags.STAIRS) || state.is(BlockTags.SLABS))
+            || settings.trapdoors() && state.is(BlockTags.TRAPDOORS)
+            || settings.chests() && (state.is(Blocks.CHEST) || state.is(Blocks.TRAPPED_CHEST) || state.is(Blocks.ENDER_CHEST) || state.is(BlockTags.COPPER_CHESTS))
+            || settings.tripwire() && (state.is(Blocks.TRIPWIRE) || state.is(Blocks.TRIPWIRE_HOOK));
+    }
+
