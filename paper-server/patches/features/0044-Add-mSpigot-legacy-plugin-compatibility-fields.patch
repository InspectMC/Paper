From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Inspect <42951016+InspectMC@users.noreply.github.com>
Date: Mon, 7 Sep 2026 09:21:43 -0500
Subject: [PATCH] Add mSpigot legacy plugin compatibility fields


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 34a8e51359002ea0593369e074ec9a7851c27b2d..85a45f313a28271dbe8e22b66bdb3c159c12f406 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -367,6 +367,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     private final java.util.concurrent.atomic.AtomicInteger tickTaskTickCount = new java.util.concurrent.atomic.AtomicInteger();
     private final Object statsLock = new Object();
     private double @Nullable [] tps;
+    public volatile double[] recentTps = new double[] {20.0D, 20.0D, 20.0D}; // mSpigot - legacy compatibility for reflection-based plugins
     private ca.spottedleaf.common.time.TickData.@Nullable MSPTData msptData5s;
 
     private void addTickTime(final ca.spottedleaf.common.time.TickTime time) {
@@ -384,6 +385,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     private void clearTickTimeStatistics() {
         this.msptData5s = null;
+        this.recentTps = this.computeTPS(); // mSpigot - keep legacy recentTps reflection field fresh
         this.tps = null;
     }
 
@@ -402,6 +404,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             if (tps == null) {
                 tps = this.computeTPS();
                 this.tps = tps;
+                this.recentTps = tps.clone(); // mSpigot - keep legacy recentTps reflection field fresh
             }
             return tps.clone();
         }
